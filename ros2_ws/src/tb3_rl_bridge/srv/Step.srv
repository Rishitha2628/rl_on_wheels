# Request: [linear_vel, angular_vel]
float32[] action
---
float32[] observation      # 42 dims (same layout as GetObservation)
float32[] achieved_goal    # [robot_x, robot_y]
float32[] desired_goal     # [goal_x,  goal_y]
float32 reward
bool done
string info                # "goal_reached" | "collision" | ""
float32 progress_reward    # gated progress component (0 when front cone is blocked)
float32 front_min          # min lidar reading in front cone (meters)
bool    progress_gated     # true when progress was zeroed by clearance gate
