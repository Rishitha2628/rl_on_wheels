# Request: reset robot + goal to new random poses
bool random_pose           # always true during training; false for fixed eval spawns
float32 spawn_x            # ignored when random_pose = true
float32 spawn_y
float32 spawn_theta
float32 goal_x             # ignored when random_pose = true
float32 goal_y
# Successive goals: when true, do NOT teleport the robot,
# only spawn a new goal at radius `goal_radius` around the current pose.
# Used to chain many goals per episode without losing accumulated learning.
bool spawn_only
float32 goal_radius        # used when spawn_only=true; meters from robot
---
bool success
string info
