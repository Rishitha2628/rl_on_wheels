# Request: empty — returns current cached sensor state
---
float32[] observation      # 42 dims: 36 lidar + dist + cos + sin + goal_path_min + prev_lv + prev_av
float32[] achieved_goal    # [robot_x, robot_y]  — 2 dims
float32[] desired_goal     # [goal_x,  goal_y]   — 2 dims
bool success
# Sequence counter that env_bridge increments every time it receives a new
# /goal_pose. Python's wait_new_goal() polls this — the new goal has
# definitely arrived when goal_seq increased above the value seen before
# the reset_episode call.
uint32 goal_seq
